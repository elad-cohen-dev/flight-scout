# Provide ONE of these — the agent auto-detects the provider from the key.

# Anthropic (https://platform.claude.com/) — default model: claude-opus-5
ANTHROPIC_API_KEY=

# OpenAI (https://platform.openai.com/api-keys) — default model: gpt-5.4-mini
OPENAI_API_KEY=

# Optional overrides:
# FLIGHT_SCOUT_PROVIDER=openai        # force a provider when both keys are set
# FLIGHT_SCOUT_MODEL=gpt-5.5          # override the default model (e.g. bigger model)

# Hosted DB (Turso, https://turso.tech) — required in production (ephemeral disks);
# leave empty locally to use a SQLite file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Notifications (any combination; unset = no notifications)
# ntfy.sh: pick a private topic name, subscribe to it in the ntfy app / https://ntfy.sh/<topic>
NTFY_TOPIC=
# Telegram: create a bot with @BotFather, get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Two-way bot (webhook): 16+ chars of A-Z a-z 0-9 _ -, then register it (see README "Telegram bot")
TELEGRAM_WEBHOOK_SECRET=
# PUBLIC_URL=https://your-app.onrender.com

# Shared secret required by POST /api/watches/run (set the same value in GitHub Actions)
CRON_SECRET=

# App password: when set, the web app and API require it (lock screen in the UI).
# Leave empty for open access (e.g. local dev).
APP_PASSWORD=
